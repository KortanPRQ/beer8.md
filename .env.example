# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=beer8_user
DB_PASSWORD=your_secure_password_here
DB_NAME=beer8_db

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret (generate a strong random string)
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRE=7d

# Session Secret
SESSION_SECRET=your_session_secret_change_this_in_production

# Email Configuration (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_email_password
EMAIL_FROM=Beer8 <noreply@beer8.md>

# Twilio SMS Configuration (Optional - for future use)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Frontend URL
CLIENT_URL=http://localhost:5173

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Restaurant Information
RESTAURANT_NAME=Beer8
RESTAURANT_ADDRESS=Strada Conev 34, Bălți MD-3100, Moldova
RESTAURANT_PHONE=+373 612 88 880
RESTAURANT_EMAIL=info@beer8.md

# Social Media
FACEBOOK_URL=https://facebook.com/beer8md
INSTAGRAM_URL=https://instagram.com/beer8md

# Google Maps API (Optional)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Security
BCRYPT_ROUNDS=12
CSRF_SECRET=your_csrf_secret_change_this_in_production
